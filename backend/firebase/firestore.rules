rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function allowedCollections() {
      // Añadido 'notes' para permitir CRUD de notas financieras
      return ['incomes','expenses','accounts','savings','debts','investments','goals','notes'];
    }

    function nonNegativeNumber(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is number && request.resource.data[field] >= 0);
    }

    function shortString(field, maxLen) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= maxLen);
    }

    function baseFieldsOK() {
      return shortString('categoria',40)
        && shortString('metodo',40)
        && shortString('descripcion',500)
        && nonNegativeNumber('monto')
        && nonNegativeNumber('montoActual')
        && nonNegativeNumber('montoObjetivo')
        && nonNegativeNumber('saldo');
    }

    // Perfil de usuario (si se usa un doc directo users/{uid})
    match /users/{userId} {
      // Permitir crear el documento durante el registro (cuando request.auth.uid == userId)
      // o cuando el usuario ya está autenticado y es el dueño
      allow get, update, delete: if isOwner(userId);
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Subcolecciones esperadas bajo users/{uid}
    match /users/{userId}/{collection}/{docId} {
      allow list, get: if isOwner(userId) && collection in allowedCollections();
      allow create, update: if isOwner(userId)
        && collection in allowedCollections()
        && baseFieldsOK();
      allow delete: if isOwner(userId) && collection in allowedCollections();
    }

    // Bloqueo por defecto de cualquier otra ruta
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
